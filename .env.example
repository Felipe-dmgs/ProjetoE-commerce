# .env.example
# ------------
# Copie este arquivo para ".env" (mesmo nome, sem ".example") e ajuste os
# valores se quiser. O ".env" é lido automaticamente pelo docker-compose.yml
# (chave "env_file") e passado como variáveis de ambiente para o container "web".
#
#   cp .env.example .env
#
# IMPORTANTE: o arquivo ".env" (o de verdade) NÃO deve ser commitado no Git,
# pois normalmente guarda segredos. Ele já está listado no .gitignore.

# --- Django ---
SECRET_KEY=troque-esta-chave-por-uma-bem-aleatoria-em-producao
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados (usado tanto pelo container "db" quanto pelo "web") ---
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce
DATABASE_PASSWORD=ecommerce
